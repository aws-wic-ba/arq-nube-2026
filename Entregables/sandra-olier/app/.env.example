# Variables de entorno para desarrollo local
# ⚠️ En producción se gestionan con AWS Secrets Manager, nunca en texto plano.

# Configuración de MySQL
MYSQL_HOST=db
MYSQL_USER=mesauser
MYSQL_PASSWORD=mesapass
MYSQL_DATABASE=mesafacil
MYSQL_ROOT_PASSWORD=rootpass

# Configuración de la aplicación
APP_PORT=3000
NODE_ENV=development

# URL de conexión a la base de datos (usada por la app)
DATABASE_URL=mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@${MYSQL_HOST:-db}:3306/${MYSQL_DATABASE}
